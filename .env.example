# NUVORA AI environment variables: NAMES ONLY.
#
# Copy this file to .env.local for local work and fill in real values there.
# Never commit real values. .env.local is ignored by git (see .gitignore).
# Secrets (keys, tokens, service accounts) must only be read in server-side code.
#
# Phase 1 (skeleton and interface) needs NO environment variables.
# The names below are reserved for later phases and are NOT used yet.
# They stay commented out until the feature that needs them is built and
# approved.

# --- Planned: public site settings (safe to expose in the browser) ---
# NEXT_PUBLIC_SITE_URL=

# --- Planned: accounts and data (Phase 2, needs owner approval first) ---
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON=        # server only, never in client code

# --- Planned: AI provider (Phase 3, provider and spending cap not chosen yet) ---
# AI_PROVIDER=
# AI_API_KEY=                           # server only, never in client code
# AI_MONTHLY_SPEND_CAP_USD=
# AI_KILL_SWITCH=
